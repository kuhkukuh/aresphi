{
  "featureId": "F-001",
  "title": "Project Setup & Infrastructure",
  "summary": "Initialize Next.js 14+ project with TypeScript, Tailwind CSS, Drizzle ORM, Neon PostgreSQL, Clean Architecture structure, and base environment configuration.",
  "acceptanceCriteria": [
    {
      "id": "AC-001",
      "given": "Developer runs npm install",
      "when": "All dependencies are installed",
      "then": "No errors and package.json contains Next.js 14+, TypeScript, Tailwind CSS, Drizzle ORM",
      "testable": true,
      "testCommand": "npm ls next typescript tailwindcss drizzle-orm"
    },
    {
      "id": "AC-002",
      "given": "Project structure is created",
      "when": "Developer navigates to src/ directory",
      "then": "Clean Architecture folders exist: domain/, application/, infrastructure/, presentation/",
      "testable": true,
      "testCommand": "ls -d src/domain src/application src/infrastructure src/presentation"
    },
    {
      "id": "AC-003",
      "given": "Tailwind CSS is configured",
      "when": "Developer adds a className with Tailwind utility",
      "then": "Styles are applied correctly",
      "testable": true,
      "testCommand": "npm run build"
    },
    {
      "id": "AC-004",
      "given": "Drizzle ORM is configured",
      "when": "Database connection is attempted",
      "then": "Connection to Neon PostgreSQL succeeds",
      "testable": true,
      "testCommand": "npm run db:push"
    },
    {
      "id": "AC-005",
      "given": "TypeScript strict mode is enabled",
      "when": "Developer runs npm run build",
      "then": "No TypeScript errors with strict mode",
      "testable": true,
      "testCommand": "npm run build && npm run lint"
    },
    {
      "id": "AC-006",
      "given": "Environment variables are documented",
      "when": "Developer opens .env.example",
      "then": "All required env vars are listed with descriptions",
      "testable": true,
      "testCommand": "test -f .env.example"
    },
    {
      "id": "AC-007",
      "given": "App Router is configured",
      "when": "Developer starts dev server",
      "then": "Application loads at localhost:3000 with App Router structure",
      "testable": true,
      "testCommand": "npm run dev &"
    }
  ],
  "scope": {
    "inScope": [
      "Next.js 14+ App Router setup",
      "TypeScript configuration with strict mode",
      "Tailwind CSS with custom theme (orange brand color)",
      "Drizzle ORM setup",
      "Neon PostgreSQL connection",
      "Clean Architecture folder structure",
      "Environment variables setup",
      "ESLint and Prettier configuration",
      "Git ignore configuration"
    ],
    "outOfScope": [
      "Database schema definitions",
      "UI components",
      "API routes",
      "Authentication",
      "Deployment configuration"
    ]
  },
  "tasks": [
    {
      "id": "T-001",
      "description": "Initialize Next.js 14+ project with TypeScript and App Router",
      "files": ["package.json", "tsconfig.json", "next.config.ts", "app/layout.tsx", "app/page.tsx"],
      "acceptanceCriteria": ["AC-001", "AC-003", "AC-005", "AC-007"],
      "estimatedMinutes": 15
    },
    {
      "id": "T-002",
      "description": "Configure Tailwind CSS with custom theme (orange brand color, warm neutrals)",
      "files": ["tailwind.config.ts", "app/globals.css"],
      "acceptanceCriteria": ["AC-003"],
      "estimatedMinutes": 10
    },
    {
      "id": "T-003",
      "description": "Create Clean Architecture folder structure",
      "files": ["src/domain/.gitkeep", "src/application/.gitkeep", "src/infrastructure/.gitkeep", "src/presentation/.gitkeep"],
      "acceptanceCriteria": ["AC-002"],
      "estimatedMinutes": 5
    },
    {
      "id": "T-004",
      "description": "Setup Drizzle ORM configuration",
      "files": ["drizzle.config.ts", "src/infrastructure/database/index.ts"],
      "acceptanceCriteria": ["AC-004"],
      "estimatedMinutes": 15
    },
    {
      "id": "T-005",
      "description": "Create environment variables template",
      "files": [".env.example", ".env.local"],
      "acceptanceCriteria": ["AC-004", "AC-006"],
      "estimatedMinutes": 10
    },
    {
      "id": "T-006",
      "description": "Configure ESLint and Prettier",
      "files": [".eslintrc.json", ".prettierrc", ".prettierignore"],
      "acceptanceCriteria": ["AC-005"],
      "estimatedMinutes": 10
    },
    {
      "id": "T-007",
      "description": "Setup Git configuration",
      "files": [".gitignore"],
      "acceptanceCriteria": ["AC-006"],
      "estimatedMinutes": 5
    },
    {
      "id": "T-008",
      "description": "Add npm scripts for database operations",
      "files": ["package.json"],
      "acceptanceCriteria": ["AC-004"],
      "estimatedMinutes": 5
    }
  ],
  "harness": {
    "setup": [
      "npx create-next-app@latest . --typescript --tailwind --eslint --app --src-dir --import-alias '@/*'",
      "npm install drizzle-orm @neondatabase/serverless",
      "npm install -D drizzle-kit"
    ],
    "testsToWrite": [],
    "validators": [
      "npm run build",
      "npm run lint"
    ]
  }
}
