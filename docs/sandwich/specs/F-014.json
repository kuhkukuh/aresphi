{
  "featureId": "F-014",
  "title": "Design System & Component Library",
  "summary": "Typography system (Playfair Display + Geist fonts), color palette (orange brand + warm neutrals), reusable UI components, Framer Motion animations, and property card with hover glow effect.",
  "acceptanceCriteria": [
    {
      "id": "AC-001",
      "given": "Tailwind config is loaded",
      "when": "Developer uses font-serif or font-sans classes",
      "then": "Playfair Display is applied for serif, Geist for sans-serif",
      "testable": true,
      "testCommand": "npm run build"
    },
    {
      "id": "AC-002",
      "given": "Custom color classes are used",
      "when": "Developer applies bg-orange-500, text-stone-800, etc.",
      "then": "Correct brand colors are rendered",
      "testable": true,
      "testCommand": "npm run build"
    },
    {
      "id": "AC-003",
      "given": "Button component is imported",
      "when": "Button is rendered with variant prop",
      "then": "Correct styles are applied (primary, secondary, outline)",
      "testable": true,
      "testCommand": "npm test -- --grep 'Button'"
    },
    {
      "id": "AC-004",
      "given": "PropertyCard component is rendered",
      "when": "User hovers over the card",
      "then": "Glow/highlight effect is triggered following mouse position",
      "testable": true,
      "testCommand": "npm test -- --grep 'PropertyCard'"
    },
    {
      "id": "AC-005",
      "given": "FadeInUp animation is applied to an element",
      "when": "Element enters viewport",
      "then": "Element fades in and slides up with animation",
      "testable": true,
      "testCommand": "npm test -- --grep 'FadeInUp'"
    },
    {
      "id": "AC-006",
      "given": "Input component is rendered",
      "when": "User focuses and types in input",
      "then": "Focus ring and border styles are applied correctly",
      "testable": true,
      "testCommand": "npm test -- --grep 'Input'"
    },
    {
      "id": "AC-007",
      "given": "Card component is rendered",
      "when": "Card is used in layout",
      "then": "Correct rounded corners, shadow, and padding are applied",
      "testable": true,
      "testCommand": "npm test -- --grep 'Card'"
    },
    {
      "id": "AC-008",
      "given": "Container component is used",
      "when": "Page content is wrapped in Container",
      "then": "Content is centered with proper max-width and padding",
      "testable": true,
      "testCommand": "npm run build"
    }
  ],
  "scope": {
    "inScope": [
      "Typography system (Playfair Display + Geist)",
      "Color palette configuration (orange, stone neutrals, accents)",
      "Button component (primary, secondary, outline variants)",
      "Input component",
      "Card component",
      "PropertyCard with hover glow effect",
      "Container component",
      "FadeInUp animation utility",
      "FadeIn animation utility",
      "Base Tailwind utilities extension"
    ],
    "outOfScope": [
      "Property listing page",
      "Property detail page",
      "Navigation/Header component",
      "Footer component",
      "Form validation logic",
      "Complex carousel/slider"
    ]
  },
