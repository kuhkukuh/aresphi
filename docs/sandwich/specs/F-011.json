{
  "featureId": "F-011",
  "title": "WhatsApp Integration",
  "summary": "Pre-filled WhatsApp message generation for property inquiry with floating button on all public pages. PRIMARY BUSINESS GOAL: Lead generation.",
  "acceptanceCriteria": [
    {
      "id": "AC-001",
      "given": "WhatsApp utility is imported",
      "when": "generateWhatsAppLink is called with phone and message",
      "then": "Correct wa.me URL with encoded message is returned",
      "testable": true,
      "testCommand": "npm test -- --grep 'generateWhatsAppLink'"
    },
    {
      "id": "AC-002",
      "given": "User is on any public page",
      "when": "Page renders",
      "then": "Floating WhatsApp button is visible in bottom-right corner",
      "testable": true,
      "testCommand": "npm run build"
    },
    {
      "id": "AC-003",
      "given": "User clicks floating WhatsApp button",
      "when": "Button is clicked",
      "then": "New tab opens wa.me link with default greeting message",
      "testable": true,
      "testCommand": "npm test -- --grep 'FloatingWhatsApp'"
    },
    {
      "id": "AC-004",
      "given": "User views property detail page",
      "when": "Property inquiry CTA is rendered",
      "then": "WhatsApp link contains property title and URL in pre-filled message",
      "testable": true,
      "testCommand": "npm test -- --grep 'propertyInquiryLink'"
    },
    {
      "id": "AC-005",
      "given": "Form for property owners is submitted",
      "when": "User fills name, phone, property address",
      "then": "WhatsApp opens with form data in pre-filled message",
      "testable": true,
      "testCommand": "npm test -- --grep 'ownerInquiryForm'"
    },
    {
      "id": "AC-006",
      "given": "NEXT_PUBLIC_WHATSAPP_NUMBER is not set",
      "when": "WhatsApp component renders",
      "then": "Component handles missing env var gracefully",
      "testable": true,
      "testCommand": "npm test -- --grep 'missing-env'"
    }
  ],
  "scope": {
    "inScope": [
      "WhatsApp URL generation utility",
      "Floating WhatsApp button component",
      "Property inquiry CTA with pre-filled message",
      "Owner inquiry form with WhatsApp redirect",
      "Animation for floating button (pulse ring)",
      "Environment variable for WhatsApp number"
    ],
    "outOfScope": [
      "WhatsApp Business API integration",
      "Message templates management",
      "Chat history storage",
      "Lead tracking/analytics"
    ]
  },
  "tasks": [
    {
      "id": "T-001",
      "description": "Create WhatsApp utility functions for link generation",
      "files": ["src/infrastructure/external/whatsapp.ts"],
      "acceptanceCriteria": ["AC-001", "AC-004", "AC-005"],
      "estimatedMinutes": 15
    },
    {
      "id": "T-002",
      "description": "Create FloatingWhatsApp component",
      "files": ["src/presentation/components/features/FloatingWhatsApp.tsx"],
      "acceptanceCriteria": ["AC-002", "AC-003"],
      "estimatedMinutes": 20
    },
    {
      "id": "T-003",
      "description": "Add FloatingWhatsApp to public layout",
      "files": ["app/(public)/layout.tsx"],
      "acceptanceCriteria": ["AC-002"],
      "estimatedMinutes": 5
    },
    {
      "id": "T-004",
      "description": "Create Property Inquiry CTA component",
      "files": ["src/presentation/components/features/PropertyInquiryCTA.tsx"],
      "acceptanceCriteria": ["AC-004"],
      "estimatedMinutes": 15
    },
    {
      "id": "T-005",
      "description": "Create Owner Inquiry Form component",
      "files": ["src/presentation/components/features/OwnerInquiryForm.tsx"],
      "acceptanceCriteria": ["AC-005"],
      "estimatedMinutes": 20
    },
    {
      "id": "T-006",
      "description": "Add WhatsApp env var to .env.example",
      "files": [".env.example"],
      "acceptanceCriteria": ["AC-001"],
      "estimatedMinutes": 5
    },
    {
      "id": "T-007",
      "description": "Write unit tests for WhatsApp utilities",
      "files": ["src/infrastructure/external/__tests__/whatsapp.test.ts"],
      "acceptanceCriteria": ["AC-001", "AC-004", "AC-005", "AC-006"],
      "estimatedMinutes": 20
    }
  ],
  "harness": {
    "setup": [
      "npm install framer-motion"
    ],
    "testsToWrite": [
      "src/infrastructure/external/__tests__/whatsapp.test.ts",
      "src/presentation/components/features/__tests__/FloatingWhatsApp.test.tsx"
    ],
    "validators": [
      "npm run build",
      "npm test",
      "npm run lint"
    ]
  }
}
