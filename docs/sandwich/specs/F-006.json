{
  "featureId": "F-006",
  "title": "Homepage - Company Profile",
  "summary": "Landing page with hero section, company profile, services preview, property highlights, testimonials, team profiles, and contact CTA. Primary goal: Build trust and drive WhatsApp inquiries.",
  "acceptanceCriteria": [
    {
      "id": "AC-001",
      "given": "User visits the homepage",
      "when": "Page loads",
      "then": "Hero section displays with headline, subheadline, CTA button, and background image",
      "testable": true,
      "testCommand": "npm run build && curl localhost:3000 | grep 'hero'"
    },
    {
      "id": "AC-002",
      "given": "Homepage renders",
      "when": "User scrolls past hero",
      "then": "About Us section with company description and USPs is visible",
      "testable": true,
      "testCommand": "npm run build"
    },
    {
      "id": "AC-003",
      "given": "Stats section is rendered",
      "when": "Section enters viewport",
      "then": "Numbers animate from 0 to target value (properties sold, clients, years experience)",
      "testable": true,
      "testCommand": "npm test -- --grep 'AnimatedCounter'"
    },
    {
      "id": "AC-004",
      "given": "Property highlights section exists",
      "when": "Section renders",
      "then": "Up to 6 featured properties display as cards with hover glow effect",
      "testable": true,
      "testCommand": "npm run build"
    },
    {
      "id": "AC-005",
      "given": "Testimonials section exists",
      "when": "User views section",
      "then": "Client testimonials display in carousel/slider format",
      "testable": true,
      "testCommand": "npm test -- --grep 'Testimonials'"
    },
    {
      "id": "AC-006",
      "given": "Team section is rendered",
      "when": "Section displays",
      "then": "Team member cards show photo, name, role, and optional WhatsApp link",
      "testable": true,
      "testCommand": "npm run build"
    },
    {
      "id": "AC-007",
      "given": "User is on homepage",
      "when": "FloatingWhatsApp is present",
      "then": "WhatsApp button is visible in bottom-right corner",
      "testable": true,
      "testCommand": "npm run build"
    },
    {
      "id": "AC-008",
      "given": "Homepage loads",
      "when": "SEO metadata is requested",
      "then": "Correct title, description, and OpenGraph tags are present",
      "testable": true,
      "testCommand": "npm run build"
    }
  ],
  "scope": {
    "inScope": [
      "Hero section with background image, headline, CTA",
      "About Us section with company description",
      "USP grid (3-4 unique selling points)",
      "Animated statistics counter",
      "Featured properties section (static or from CMS)",
      "Testimonials carousel/slider",
      "Team profiles section",
      "Contact CTA section",
      "WhatsApp integration",
      "SEO metadata",
      "FadeInUp scroll animations"
    ],
    "outOfScope": [
      "Property listing page",
      "Property detail page",
      "Admin content management",
      "Blog section on homepage",
      "Newsletter signup form",
      "Live chat widget"
    ]
  },
  "tasks": [
    {
      "id": "T-001",
      "description": "Create page structure and SEO metadata",
      "files": ["app/page.tsx", "app/layout.tsx"],
      "acceptanceCriteria": ["AC-001", "AC-008"],
      "estimatedMinutes": 15
    },
    {
      "id": "T-002",
      "description": "Create HeroSection component",
      "files": ["src/presentation/components/sections/HeroSection.tsx"],
      "acceptanceCriteria": ["AC-001"],
      "estimatedMinutes": 25
    },
    {
      "id": "T-003",
      "description": "Create AboutSection component with USPs",
      "files": ["src/presentation/components/sections/AboutSection.tsx"],
      "acceptanceCriteria": ["AC-002"],
      "estimatedMinutes": 20
    },
    {
      "id": "T-004",
      "description": "Create StatsSection with animated counters",
      "files": ["src/presentation/components/sections/StatsSection.tsx", "src/presentation/components/ui/AnimatedCounter.tsx"],
      "acceptanceCriteria": ["AC-003"],
      "estimatedMinutes": 25
    },
    {
      "id": "T-005",
      "description": "Create FeaturedProperties section",
      "files": ["src/presentation/components/sections/FeaturedProperties.tsx"],
      "acceptanceCriteria": ["AC-004"],
      "estimatedMinutes": 20
    },
    {
      "id": "T-006",
      "description": "Create TestimonialsSection with carousel",
      "files": ["src/presentation/components/sections/TestimonialsSection.tsx"],
      "acceptanceCriteria": ["AC-005"],
      "estimatedMinutes": 30
    },
    {
      "id": "T-007",
      "description": "Create TeamSection component",
      "files": ["src/presentation/components/sections/TeamSection.tsx"],
      "acceptanceCriteria": ["AC-006"],
      "estimatedMinutes": 20
    },
    {
      "id": "T-008",
      "description": "Create ContactCTA section",
      "files": ["src/presentation/components/sections/ContactCTA.tsx"],
      "acceptanceCriteria": ["AC-007"],
      "estimatedMinutes": 15
    },
    {
      "id": "T-009",
      "description": "Assemble homepage with all sections and animations",
      "files": ["app/page.tsx"],
      "acceptanceCriteria": ["AC-001", "AC-002", "AC-003", "AC-004", "AC-005", "AC-006", "AC-007"],
      "estimatedMinutes": 15
    }
  ],
  "harness": {
    "setup": [
      "npm install framer-motion"
    ],
    "testsToWrite": [
      "src/presentation/components/sections/__tests__/HeroSection.test.tsx",
      "src/presentation/components/ui/__tests__/AnimatedCounter.test.tsx"
    ],
    "validators": [
      "npm run build",
      "npm test",
      "npm run lint"
    ]
  }
}
